server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # El front llama al backend por su dominio publico (VITE_API_URL).
    # Ya no proxeamos /api por red privada (evita 504 por DNS interno cacheado).

    # Assets con hash: cache largo. Si no existe, 404 limpio (no index.html)
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html nunca se cachea: siempre referencia los chunks actuales
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
}
