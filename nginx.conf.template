server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Proxy /api al backend por la red privada de Railway.
    # envsubst reemplaza estas variables ANTES de que nginx lea la config,
    # dejando un host literal que nginx resuelve al arrancar (sin resolver).
    location /api/ {
        proxy_pass http://${BACKEND_INTERNAL_HOST}:${BACKEND_INTERNAL_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # Assets con hash: cache largo. Si no existe, 404 limpio (no index.html)
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html nunca se cachea: siempre referencia los chunks actuales
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
}
